# Copia este archivo como .env y ajusta los valores.
# Vite solo expone al navegador las variables con prefijo VITE_.

# URL base de la API PHP.
# - En desarrollo dejalo vacio o sin definir: se usa '/api' y el proxy
#   de vite.config.js lo redirige al backend local de XAMPP.
# - En produccion apunta al dominio real del backend, sin barra final:
#     VITE_API_URL=https://api.orientperfumes.com
VITE_API_URL=
