# Variables de entorno del backend PHP.
#
# PHP no lee este archivo automaticamente: es documentacion de las
# variables que hay que definir en el panel del hosting (Render,
# Railway, cPanel...) o en la configuracion de Apache.
# Si no se definen, Configuracion.php cae en los valores por defecto
# de XAMPP y el entorno local sigue funcionando igual.

# ── Base de datos ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orientperfums
DB_USER=root
DB_PASS=

# ── CORS ────────────────────────────────────────────────────
# Dominios autorizados a llamar la API, separados por comas y sin
# barra final. Si se deja vacio se permiten los puertos locales de
# desarrollo (5173, 4173 y localhost).
# Produccion:
#   CORS_ORIGINS=https://orientperfumes.com,https://www.orientperfumes.com
CORS_ORIGINS=

# ── Subidas ─────────────────────────────────────────────────
# Ruta publica desde la que se sirven las imagenes y videos subidos.
# En XAMPP el backend cuelga de /OrientPerfumesV2/, pero en un
# contenedor la raiz es otra. Sin barra final.
# Contenedor:  UPLOADS_BASE_URL=/uploads
# Subdominio:  UPLOADS_BASE_URL=https://api.orientperfumes.com/uploads
UPLOADS_BASE_URL=

# ── Depuracion ──────────────────────────────────────────────
# APP_DEBUG=1 devuelve el detalle del error de conexion en la
# respuesta JSON. Dejar SIEMPRE en 0 (o sin definir) en produccion.
APP_DEBUG=0
